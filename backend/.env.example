NODE_ENV=development
PORT=8080
CORS_ORIGIN=*

# Postgres (Railway plugin). Locally, `npm run dev:local` starts an embedded Postgres instead.
DATABASE_URL=

# ── Admin login (ayoma app) ──
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
# The secret password typed on the admin login screen. Sessions last 24 hours.
ADMIN_PASSWORD=

# ── SonicPesa (M-Pesa, Mixx by Yas, Airtel Money, HaloPesa, TTCL) ──
# Access key from the SonicPesa dashboard (X-API-KEY).
SONICPESA_API_KEY=
# Secret key. Also used to verify webhook signatures.
SONICPESA_SECRET_KEY=
# Optional. Leave empty to sign webhooks with SONICPESA_SECRET_KEY.
SONICPESA_WEBHOOK_SECRET=
# Webhook URL to set in the SonicPesa dashboard:
# https://ayoma-production.up.railway.app/api/v1/webhooks/sonicpesa

# ── Firebase Cloud Messaging (push notifications) ──
# Paste the whole service-account JSON on one line:
FCM_SERVICE_ACCOUNT_JSON=
# …or point to the file locally:
# FCM_SERVICE_ACCOUNT_PATH=C:\path\to\serviceAccountKey.json
